{
    "name": "@teamphnx/sduiapi",
    "version": "0.1.6",
    "description": "TypeScript SDUI API client with WebUntis authentication",
    "keywords": [
        "sdui"
    ],
    "homepage": "https://github.com/TeamPHNX/SduiAPI#readme",
    "bugs": {
        "url": "https://github.com/TeamPHNX/SduiAPI/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TeamPHNX/SduiAPI.git"
    },
    "license": "GPL-3.0-only",
    "author": "TeamPHNX",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc --noEmit -p tsconfig.json",
        "dev": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:live": "vitest run --config vitest.live.config.ts"
    },
    "dependencies": {
        "axios": "^1.13.1",
        "axios-cookiejar-support": "^6.0.5",
        "tough-cookie": "^5.1.2"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "dotenv": "^17.2.3",
        "eslint": "^10.1.0",
        "nock": "^14.0.10",
        "prettier": "^3.8.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.2",
        "vitest": "^3.2.4"
    }
}
